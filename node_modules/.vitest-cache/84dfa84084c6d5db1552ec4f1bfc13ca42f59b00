function calcularDesconto(valorCompra) {
	let percentual = 0;
	if (valorCompra >= 200) {
		percentual = .2;
	} else if (valorCompra >= 100) {
		percentual = .1;
	};
	const valorFinal = valorCompra * (1 - percentual);
	return Math.round((valorFinal + Number.EPSILON) * 100) / 100;
}

